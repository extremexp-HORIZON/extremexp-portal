# ExtremeXP Portal Web App - Environment Variables
#
# Copy this file to .env.local and update the values as needed.
# All VITE_* variables are exposed to the client-side code.
#
# See src/config/externalLinks.ts for default values and documentation.

# =============================================================================
# Experiment Editor Links (require experiment ID as query parameter)
# =============================================================================

# Graphical experiment editor URL
# VITE_EXPERIMENT_GRAPHICAL_EDITOR_URL=https://your-editor.example.com/graphical

# Code-based experiment editor URL
# VITE_EXPERIMENT_CODE_EDITOR_URL=https://your-editor.example.com/code

# Experiment scheduling tool URL
# VITE_EXPERIMENT_SCHEDULE_URL=https://your-scheduler.example.com

# =============================================================================
# Workflow Editor Links (require workflow ID as query parameter)
# =============================================================================

# Code-based workflow editor URL
# VITE_WORKFLOW_CODE_EDITOR_URL=https://your-workflow-editor.example.com/code

# =============================================================================
# Observe & Analyze Links (require experiment ID as query parameter)
# =============================================================================

# Gamification dashboard URL
# VITE_GAMIFICATION_URL=https://your-gamification.example.com

# Experiment card view URL
# VITE_EXPERIMENT_CARD_URL=https://your-experiment-card.example.com

# =============================================================================
# Management Links (no parameters)
# =============================================================================

# Access control policy editor URL
# VITE_ACCESS_CONTROL_POLICY_EDITOR_URL=https://your-access-control.example.com/policy-editor

# Data management upload/annotate tool URL
# VITE_DATA_MANAGEMENT_UPLOAD_ANNOTATE_URL=https://your-data-management.example.com/upload-annotate

# =============================================================================
# Footer Links
# =============================================================================

# Project homepage URL (default: https://extremexp.eu/)
# VITE_PROJECT_PAGE_URL=https://extremexp.eu/

# Privacy policy page URL
# VITE_PRIVACY_POLICY_URL=https://your-site.example.com/privacy-policy
